{
  "info": {
    "name": "uniprj-ms",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway", "value": "http://localhost:8060" },
    { "key": "eureka",  "value": "http://localhost:8061" },
    { "key": "config",  "value": "http://localhost:8088" }
  ],
  "item": [
    {
      "name": "Student Service",
      "item": [
        {
          "name": "GET all students",
          "request": {
            "method": "GET",
            "url": "{{gateway}}/student-api/students"
          }
        },
        {
          "name": "GET student by ID",
          "request": {
            "method": "GET",
            "url": "{{gateway}}/student-api/students/1"
          }
        },
        {
          "name": "GET students by lastname",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{gateway}}/student-api/students/test?name=Ferrari",
              "host": ["{{gateway}}"],
              "path": ["student-api", "students", "test"],
              "query": [{ "key": "name", "value": "Ferrari" }]
            }
          }
        },
        {
          "name": "GET students by gender",
          "request": {
            "method": "GET",
            "url": "{{gateway}}/student-api/students/roles/MALE",
            "description": "Valori possibili: MALE, FEMALE"
          }
        },
        {
          "name": "POST create student",
          "request": {
            "method": "POST",
            "url": "{{gateway}}/student-api/students",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Paolo\",\n  \"lastName\": \"Greco\",\n  \"email\": \"paolo.greco@email.com\",\n  \"birthDate\": \"2001-06-15\",\n  \"gender\": \"MALE\",\n  \"examAverageGrade\": 27.5,\n  \"wantsNewsletter\": true,\n  \"addressStreet\": \"Via Libertà\",\n  \"addressNumber\": \"10\",\n  \"addressCity\": \"Cosenza\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "PUT update student",
          "request": {
            "method": "PUT",
            "url": "{{gateway}}/student-api/students/1",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Luca\",\n  \"lastName\": \"Ferrari\",\n  \"email\": \"luca.ferrari.new@email.com\",\n  \"birthDate\": \"2000-05-15\",\n  \"gender\": \"MALE\",\n  \"examAverageGrade\": 29.0,\n  \"wantsNewsletter\": false,\n  \"addressStreet\": \"Via Roma\",\n  \"addressNumber\": \"123\",\n  \"addressCity\": \"Milano\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "DELETE student",
          "request": {
            "method": "DELETE",
            "url": "{{gateway}}/student-api/students/1"
          }
        }
      ]
    },
    {
      "name": "Teacher Service",
      "item": [
        {
          "name": "GET all teachers",
          "request": {
            "method": "GET",
            "url": "{{gateway}}/teacher-api/teachers"
          }
        },
        {
          "name": "GET teacher by ID",
          "request": {
            "method": "GET",
            "url": "{{gateway}}/teacher-api/teachers/1"
          }
        }
      ]
    },
    {
      "name": "Course Service",
      "item": [
        {
          "name": "GET courses with teachers (Feign)",
          "request": {
            "method": "GET",
            "url": "{{gateway}}/course-api/courses-teachers",
            "description": "Aggrega dati da course-service e teacher-service tramite Feign client"
          }
        }
      ]
    },
    {
      "name": "Infrastruttura",
      "item": [
        {
          "name": "Eureka - servizi registrati",
          "request": {
            "method": "GET",
            "url": "{{eureka}}/eureka/apps",
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "Config - student-service",
          "request": {
            "method": "GET",
            "url": "{{config}}/student-service/default"
          }
        },
        {
          "name": "Config - teacher-service",
          "request": {
            "method": "GET",
            "url": "{{config}}/teacher-service/default"
          }
        },
        {
          "name": "Config - course-service",
          "request": {
            "method": "GET",
            "url": "{{config}}/course-service/default"
          }
        },
        {
          "name": "Config - gateway-service",
          "request": {
            "method": "GET",
            "url": "{{config}}/gateway-service/default"
          }
        }
      ]
    }
  ]
}
